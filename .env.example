# BENIN360 Frontend Environment Variables

# Backend API URL (Optional, defaults to local browser store if omitted)
VITE_API_URL=http://localhost:8000/api/v1

# Supabase (Optional, fallback store runs seamlessly without keys)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Map Provider (Optional, defaults to built-in projected GIS canvas)
VITE_MAP_PROVIDER=custom
